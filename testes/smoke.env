# Variáveis usadas só pelo smoke test (no lugar do .env real).
# O domínio é fictício: o teste força a resolução para 127.0.0.1 com
# "curl --resolve", então nada sai para a internet.
DOMINIO=whoami.smoke.test
HOST_SEM_LABEL=sem-label.smoke.test
# Loki: desliga a trava "disco acima de 90% = recusa linhas" (ver o serviço
# loki no docker-compose.yml). Na máquina de teste o disco pode estar cheio
# por outros motivos; na VPS a trava continua valendo (padrão 0.9).
LOKI_LIMITE_DISCO=0
