// Configuração do Grafana Alloy: coleta os logs de TODOS os containers da
// VPS e manda para o Loki da borda.
//
// Caminho de uma linha de log:
//   container escreve no stdout/stderr
//   -> Docker guarda (driver json-file)
//   -> Alloy lê pela API do Docker, via docker-socket-proxy (só leitura)
//   -> rótulos (projeto, servico, stream; tipo e router no Traefik)
//   -> descarta o ruído do socket-proxy (passo 4)
//   -> Loki (http://loki:3100), que guarda por 30 dias
//
// O Alloy NUNCA monta /var/run/docker.sock: fala com o socket-proxy, que só
// libera GET (POST=0). Um bug ou falha aqui não dá controle do Docker.
//
// Rótulos (labels) são poucos e de baixa cardinalidade, porque cada
// combinação de valores vira um "stream" no Loki. O resto (status, caminho,
// IP do visitante, duração...) fica no corpo da linha e é extraído na
// consulta com LogQL, ex.: {tipo="acesso"} | json | DownstreamStatus >= 500
//
// Referência: https://grafana.com/docs/alloy/latest/reference/components/

// 1. Descoberta: lista os containers pela API do Docker (GET /containers/json,
//    GET /networks), a cada 15 s. Site novo plugado na borda entra sozinho.
discovery.docker "containers" {
  host             = "tcp://socket-proxy:2375"
  refresh_interval = "15s"
}

// 2. Regras de rótulo. Os metadados do Docker chegam como "__meta_docker_*"
//    (descartados no fim); só o que for copiado para um nome sem "__" vira
//    rótulo no Loki.
discovery.relabel "containers" {
  targets = []

  // Projeto do compose (ex.: conan-torres, bbcontainer, traefik).
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "projeto"
  }

  // Serviço do compose (ex.: web, app, traefik).
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "servico"
  }

  // stdout ou stderr (preenchido pelo loki.source.docker a cada linha).
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

// 3. Leitura dos logs: segue cada container descoberto pela API do Docker
//    (GET /containers/{id}/logs), também pelo socket-proxy. A posição de
//    leitura fica em --storage.path (volume "alloy-dados"), então reiniciar o
//    Alloy não duplica nem pula linhas.
loki.source.docker "containers" {
  host          = "tcp://socket-proxy:2375"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.linhas.receiver]
}

// 4. Tratamento das linhas antes do envio. As linhas que nenhum passo abaixo
//    pega passam direto, sem mudança.
loki.process "linhas" {
  forward_to = [loki.write.loki.receiver]

  // Socket-proxy: descartado. O HAProxy dele registra CADA consulta à API
  // do Docker (o Alloy consulta o tempo todo: um inspect por container a
  // cada 15 s), um fluxo constante que encheria o Loki de ruído por 30
  // dias. Custo: os 403 (pedido bloqueado pelo proxy) também
  // somem do Loki; para investigar, "docker compose logs socket-proxy" na
  // VPS (o Docker ainda guarda as últimas linhas, com rotação).
  stage.match {
    selector            = "{servico=\"socket-proxy\"}"
    action              = "drop"
    drop_counter_reason = "ruido_socket_proxy"
  }

  // Linhas do Traefik: separa o log de ACESSO (uma linha JSON por
  // requisição, ver accessLog em traefik/traefik.yml) do log do PRÓPRIO
  // Traefik (texto: erros de ACME, de roteamento...).

  // Log de acesso: começa com "{".
  stage.match {
    selector = "{servico=\"traefik\"} |~ \"^\\\\{\""

    stage.static_labels {
      values = { tipo = "acesso" }
    }

    // Rótulo "router" vem do RouterName (ex.: conan-torres@docker): conjunto
    // FECHADO, só os routers configurados. NUNCA do RequestHost: o Host vem
    // do cliente, e bots mandando qualquer Host explodiriam o número de
    // streams. Requisição que não casou com nenhum router (404 da borda) não
    // tem RouterName e fica sem o rótulo.
    stage.json {
      expressions = { router = "RouterName" }
    }

    stage.labels {
      values = { router = "" }
    }
  }

  // Log do próprio Traefik: tudo que não é JSON.
  stage.match {
    selector = "{servico=\"traefik\"} !~ \"^\\\\{\""

    stage.static_labels {
      values = { tipo = "traefik" }
    }
  }
}

// 4b. Log do cron de atualização dos sites (vps/atualizar-apps.sh), um
//     arquivo no host, montado SÓ LEITURA em /log-host (a pasta, não o
//     arquivo: o logrotate renomeia o arquivo e cria outro, e um bind de
//     arquivo único ficaria preso ao antigo). O loki.source.file segue o
//     caminho: ao rotacionar, larga o arquivo renomeado e lê o novo. A
//     posição fica no --storage.path. Rótulo único e fixo (job), sem
//     cardinalidade nova; vai direto ao Loki, sem os estágios dos containers.
local.file_match "atualizar_apps" {
  path_targets = [{
    __path__ = "/log-host/atualizar-apps.log",
    job      = "atualizar-apps",
  }]
  sync_period = "15s"
}

loki.source.file "atualizar_apps" {
  targets    = local.file_match.atualizar_apps.targets
  forward_to = [loki.write.loki.receiver]
}

// 5. Envio ao Loki da borda, pela rede interna "logs" (fora da rede "proxy").
loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
